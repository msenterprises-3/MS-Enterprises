# ==============================================================================
# MS Furniture Gallery - Environment Variables Configuration Template
# Copy this file to .env and fill in the values for your deployment environment.
# ==============================================================================

# --- Flask Server Settings ---
FLASK_SECRET_KEY=generate_a_long_random_secret_key_for_production
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# --- Supabase PostgreSQL Cloud Database (Optional) ---
# When provided, all queries route to your Supabase PostgreSQL tables.
# If omitted or unavailable, the application automatically falls back to local SQLite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# --- Firebase Firestore (Optional) ---
# If deploying to a serverless platform without uploading firebase-credentials.json,
# you can stringify your entire service account JSON into this single variable.
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
